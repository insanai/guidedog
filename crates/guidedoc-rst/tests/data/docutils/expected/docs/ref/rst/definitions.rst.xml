/paragraph></entry></row><row><entry><paragraph><reference name="isomfrk.txt" refuri="../../../docutils/parsers/rst/include/isomfrk.txt">isomfrk.txt</reference>  <footnote_reference ids="footnote-reference-2" refid="footnote-1">1</footnote_reference></paragraph></entry><entry><paragraph>Mathematical Fraktur</paragraph></entry></row><row><entry><paragraph><reference name="isomopf.txt" refuri="../../../docutils/parsers/rst/include/isomopf.txt">isomopf.txt</reference>  <footnote_reference ids="footnote-reference-3" refid="footnote-1">1</footnote_reference></paragraph></entry><entry><paragraph>Mathematical Openface (Double-struck)</paragraph></entry></row><row><entry><paragraph><reference name="isomscr.txt" refuri="../../../docutils/parsers/rst/include/isomscr.txt">isomscr.txt</reference>  <footnote_reference ids="footnote-reference-4" refid="footnote-1">1</footnote_reference></paragraph></entry><entry><paragraph>Mathematical Script</paragraph></entry></row><row><entry><paragraph><reference name="isonum.txt" refuri="../../../docutils/parsers/rst/include/isonum.txt">isonum.txt</reference></paragraph></entry><entry><paragraph>Numeric and Special Graphic</paragraph></entry></row><row><entry><paragraph><reference name="isopub.txt" refuri="../../../docutils/parsers/rst/include/isopub.txt">isopub.txt</reference></paragraph></entry><entry><paragraph>Publishing</paragraph></entry></row><row><entry><paragraph><reference name="isotech.txt" refuri="../../../docutils/parsers/rst/include/isotech.txt">isotech.txt</reference></paragraph></entry><entry><paragraph>General Technical</paragraph></entry></row><row><entry><paragraph><reference name="mmlalias.txt" refuri="../../../docutils/parsers/rst/include/mmlalias.txt">mmlalias.txt</reference></paragraph></entry><entry><paragraph>MathML aliases for entities from other sets</paragraph></entry></row><row><entry><paragraph><reference name="mmlextra.txt" refuri="../../../docutils/parsers/rst/include/mmlextra.txt">mmlextra.txt</reference> <fo