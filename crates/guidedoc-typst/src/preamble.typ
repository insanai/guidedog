// Generated by Guidedoc. The helper definitions below are fixed; the body follows.
// Helpers avoid elements that HTML export drops (align, grid, pad, scale) or branch on
// the export target, so the same source compiles to PDF and to HTML. Colors are muted,
// so a page reads in print as well as on screen.
#let gd-mono = ("DejaVu Sans Mono",)
// Book templates can supply their sans family for prose inside equations.
#let gd-math-sans = state("gd-math-sans", ())
#let gd-math-sans-text(font, body) = context {
  let faces = gd-math-sans.get()
  // Standalone output retains Typst's mathematical sans variant. A book supplies
  // its normal sans faces, so complex scripts receive ordinary text shaping.
  if faces == () { math.sans(body) } else { box(text(font: faces + font, body)) }
}
#let gd-tint = rgb("#f6f5f1")
#let gd-ink = rgb("#1c5f73")
#let gd-title(body) = context if target() == "html" { html.elem("h1", body) } else {
  align(center, block(below: 1.4em, text(size: 1.8em, weight: "bold", hyphenate: false,
    body)))
}
#let gd-subtitle(body) = context if target() == "html" { html.elem("p", emph(body)) } else {
  align(center, block(below: 1.4em, text(size: 1.3em, style: "italic", body)))
}
#let gd-rule() = context if target() == "html" { html.elem("hr") } else {
  align(center, block(above: 1.4em, below: 1.4em,
    line(length: 30%, stroke: 0.5pt + luma(150))))
}
#let gd-align(alignment, body) = { set align(alignment); body }
#let gd-scale(factor, body) = context if target() == "html" { body } else {
  scale(x: factor, y: factor, reflow: true, body)
}
// A template may set gd-page-ref to a function of a page number, such as
// n => [p. #n], to follow cross-references to other pages with it.
#let gd-page-ref = state("gd-page-ref", none)
#let gd-link(name, body) = context {
  let found = query(label(name))
  if found.len() == 0 { return body }
  let at = found.first().location()
  link(at, body)
  let show-page = gd-page-ref.get()
  if show-page != none and target() != "html" and at.page() != here().page() {
    [ (#show-page(numbering(at.page-numbering(), ..counter(page).at(at))))]
  }
}
#let gd-pairs(..cells) = table(columns: (auto, 1fr), stroke: none,
  inset: (x: 0pt, y: 0.35em), column-gutter: 1em, ..cells.pos())
#let gd-footnote(mark, body) = footnote(numbering: _ => mark, body)
#let gd-note(mark, body) = text(size: 0.9em, gd-pairs(super(mark), body))
#let gd-citation(mark, body) = gd-pairs([\[#mark\]], body)
#let gd-admonition-colors = (
  attention: rgb("#a8621b"), caution: rgb("#a8621b"), danger: rgb("#a3312b"),
  error: rgb("#a3312b"), hint: rgb("#3a7355"), important: rgb("#3b5f8f"),
  note: rgb("#3b5f8f"), tip: rgb("#3a7355"), warning: rgb("#a8621b"),
  seealso: rgb("#59636e"), admonition: rgb("#59636e"), todo: rgb("#76509c"),
)
// An admonition: a rule down its left side, a faint tint of the same color, and its
// title in letter-spaced small capitals.
#let gd-admonition(kind, title, body) = {
  let accent = gd-admonition-colors.at(kind, default: luma(90))
  let loud = kind in ("danger", "error", "warning", "caution", "attention")
  block(width: 100%, above: 1.35em, below: 1.35em,
    inset: (left: 11pt, right: 10pt, top: 7pt, bottom: 8pt),
    fill: accent.lighten(if loud { 93% } else { 95% }),
    stroke: (left: (if loud { 2.5pt } else { 1.8pt }) + accent), breakable: true, {
      set par(first-line-indent: 0em)
      block(above: 0em, below: 0.65em, sticky: true, text(weight: "bold", tracking: 0.06em,
        fill: accent.darken(18%), hyphenate: false, smallcaps(all: true, title)))
      body
    })
}
#let gd-topic(title, body) = block(width: 100%, above: 1.4em, below: 1.4em,
  inset: (x: 0pt, y: 8pt), stroke: (top: 0.5pt + luma(150), bottom: 0.5pt + luma(150)),
  breakable: true, {
    set par(first-line-indent: 0em)
    block(above: 0em, below: 0.6em, sticky: true,
      text(weight: "bold", tracking: 0.05em, smallcaps(all: true, title)))
    body
  })
#let gd-sidebar(title, subtitle, body) = block(width: 100%, above: 1.4em, below: 1.4em,
  inset: 10pt, fill: luma(246), stroke: 0.5pt + luma(200), radius: 2pt, breakable: true, {
    set text(size: 0.93em)
    set par(first-line-indent: 0em)
    block(above: 0em, below: 0.6em, sticky: true,
      [#text(weight: "bold", title)#if subtitle != none [ --- #emph(subtitle)]])
    body
  })
#let gd-rubric(body) = block(above: 1.4em, below: 0.7em, sticky: true,
  text(weight: "bold", style: "italic", hyphenate: false, body))
#let gd-fields(..cells) = {
  set par(justify: false, first-line-indent: 0em)
  gd-pairs(..cells.pos().enumerate().map(((i, c)) =>
    if calc.even(i) { strong(c + [:]) } else { c }))
}
#let gd-options(..cells) = {
  set par(justify: false, first-line-indent: 0em)
  gd-pairs(..cells.pos())
}
#let gd-terms(..items) = terms(separator: linebreak(), hanging-indent: 1.5em, ..items)
#let gd-classifier(body) = [ : #emph(body)]
#let gd-lines(body) = block({ set par(justify: false, first-line-indent: 0em); body })
#let gd-indent(body) = block(inset: (left: 1.5em), body)
#let gd-pre(body) = block(width: 100%, inset: (x: 9pt, y: 7pt), fill: gd-tint, radius: 2pt,
  { set par(justify: false, first-line-indent: 0em)
    text(font: gd-mono, size: 0.82em, hyphenate: false, body) })
#let gd-code-line(start, marked, it) = {
  // The code sits in a box of the remaining width, so a wrapped line continues under
  // the code, not under the number; a marked line is tinted across the whole width.
  let code = box(width: 1fr, fill: if it.number in marked { rgb("#fbeeb8") },
    outset: (y: 1.6pt, right: 3pt), { set par(hanging-indent: 2em); it.body })
  if start == none { return code }
  box(width: 2.4em, align(right, text(fill: luma(150), size: 0.9em,
    str(it.number + start - 1))))
  h(0.9em)
  code
}
#let gd-numbered(start, body, marked: ()) = context if target() == "html" { body } else {
  show raw.line: it => gd-code-line(start, marked, it)
  body
}
#let gd-equation(number, body) = { set math.equation(numbering: _ => "(" + number + ")"); body }
#let gd-secnum(number) = (..) => number
#let gd-code-text(body) = text(font: gd-mono, size: 0.86em, hyphenate: false, body)
#let gd-kbd(body) = context if target() == "html" { html.elem("kbd", body) } else {
  box(inset: (x: 2.5pt), outset: (y: 2pt), radius: 2pt, stroke: 0.5pt + luma(160),
    fill: luma(248), text(font: gd-mono, size: 0.8em, hyphenate: false, body))
}
#let gd-version-colors = (added: rgb("#3a7355"), changed: rgb("#a8621b"),
  deprecated: rgb("#a3312b"), removed: rgb("#a3312b"))
#let gd-version(kind, label, body) = {
  let accent = gd-version-colors.at(kind, default: luma(90))
  block(width: 100%, inset: (left: 9pt, y: 2pt), stroke: (left: 1.2pt + accent),
    breakable: true, {
      set par(first-line-indent: 0em)
      [#emph(text(fill: accent.darken(15%), label)) #body]
    })
}
// An object's signature: monospaced on a tinted band under a rule, its name in bold
// color; a signature too long for the line continues indented.
#let gd-signature(body, attached: true) = block(width: 100%, above: 1.6em, below: 0.7em,
  breakable: false, sticky: attached, inset: (x: 6pt, y: 5pt), fill: gd-ink.lighten(93%),
  stroke: (top: 0.7pt + gd-ink.lighten(20%)), {
    set par(justify: false, first-line-indent: 0em, hanging-indent: 2em)
    set text(font: gd-mono, size: 0.84em, hyphenate: false)
    show strong: set text(fill: gd-ink.darken(25%))
    body
  })
#let gd-description(body) = block(inset: (left: 1.5em), breakable: true, body)
#let gd-hlist(columns: 2, tight: true, start: none, ..items) = {
  let items = items.pos()
  let make(part, first) = if start == none { list(tight: tight, ..part) } else {
    enum(tight: tight, start: start + first, ..part)
  }
  context if target() == "html" { make(items, 0) } else {
    let per = calc.quo(items.len(), columns)
    let more = calc.rem(items.len(), columns)
    let cells = ()
    let i = 0
    for c in range(columns) {
      let k = per + if c < more { 1 } else { 0 }
      cells.push(make(items.slice(i, i + k), i))
      i += k
    }
    grid(columns: (1fr,) * columns, column-gutter: 1em, ..cells)
  }
}
#let gd-productions(..cells) = block(width: 100%, inset: (x: 9pt, y: 7pt), fill: gd-tint,
  radius: 2pt, text(font: gd-mono, size: 0.82em, hyphenate: false, table(
    columns: (auto, auto, 1fr), stroke: none, inset: (x: 0pt, y: 0.2em),
    column-gutter: 0.6em, ..cells.pos())))
#let gd-legend(body) = block(inset: (x: 1.5em), text(size: 0.92em, body))
#let gd-media(kind, path, body) = context if target() == "html" {
  html.elem(kind, attrs: (src: path, controls: ""), link(path, body))
} else {
  block(inset: (x: 10pt, y: 6pt), radius: 2pt, stroke: 0.5pt + luma(180), fill: luma(248),
    text(size: 0.93em)[#strong(if kind == "video" [Video] else [Audio]): #body])
}
#let gd-sectnum(depth, prefix, suffix, start) = (..nums) => {
  let n = nums.pos()
  if n.len() > depth { return none }
  prefix + numbering("1.1", ..(n.first() + start - 1, ..n.slice(1))) + suffix
}
// The pages of an index term: each page once, main entries in bold, linked.
#let gd-index-pages(links) = {
  let seen = ()
  let pages = ()
  for (main, name) in links {
    let found = query(label(name))
    if found.len() == 0 { continue }
    let at = found.first().location()
    let pattern = at.page-numbering()
    let n = numbering(if pattern == none { "1" } else { pattern }, ..counter(page).at(at))
    if n in seen { continue }
    seen.push(n)
    pages.push(if main { strong(link(at, n)) } else { link(at, n) })
  }
  pages.join([, ])
}
// An index: groups of (letter, terms); a term is (name, links, subterms); a link is
// (main, label); a subterm is (name, links).
#let gd-index(..groups) = context {
  set par(justify: false, first-line-indent: 0em, hanging-indent: 1.5em, spacing: 0.32em)
  set text(size: 0.88em, number-type: "lining", hyphenate: false)
  set block(spacing: 0.32em)
  let entry(name, links) = par[#name#if links.len() > 0 [, #gd-index-pages(links)]]
  let body = for (letter, terms) in groups.pos() {
    block(above: 1.3em, below: 0.6em, sticky: true,
      text(weight: "bold", size: 1.15em, fill: gd-ink, letter))
    for (name, links, subs) in terms {
      entry(name, links)
      for (sub, sublinks) in subs { pad(left: 1em, entry(sub, sublinks)) }
    }
  }
  if target() == "html" { body } else { columns(2, gutter: 1.6em, body) }
}
#show outline: it => { show footnote: none; it }
#show raw: set text(font: gd-mono)
// A caption must not turn a multipage table or listing into an unbreakable figure.
// Keep this in the shared preamble so existing book templates and conversions agree.
#show figure.where(kind: table): set block(breakable: true)
#show figure.where(kind: raw): set block(breakable: true)
#show figure.where(kind: table): set figure.caption(position: top)
#show figure.where(kind: raw): set align(start)
