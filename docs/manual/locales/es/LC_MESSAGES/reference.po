#: ../../reference/cli.rst:685
#, fuzzy
#| msgid ""
#| "``guidedog plugin check PATH --project=DIR --config=FILE`` tests "
#| "declared build hooks without writing a registry entry. Build-plugin "
#| "registration runs the same checks before pinning the executable. Its "
#| "request timeout defaults to 60 seconds; ``--timeout=SECONDS`` sets it. "
#| "Publisher registration remains compatible and does not invoke "
