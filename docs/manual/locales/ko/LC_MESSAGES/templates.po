#: ../../templates.rst:162
msgid "``relbar1``"
msgstr "``relbar1``"

#: ../../templates.rst:163
msgid ""
"Top navigation bar containing branding, version badge, search box, and "
"theme toggle."
msgstr "제품 이름, 버전, 검색, 테마 전환이 있는 상단 탐색 표시줄입니다."

#: ../../templates.rst:164
msgid "``rootrellink``"
msgstr "``rootrellink``"

#: ../../templates.rst:165
msgid "Insertion point in navigation bar before related links."
msgstr "관련 링크 앞의 탐색 삽입 위치입니다."

#: ../../templates.rst:166
msgid "``relbaritems``"
msgstr "``relbaritems``"

#: ../../templates.rst:167
msgid "Custom items inserted into the navigation bar."
msgstr "탐색 표시줄에 추가할 사용자 항목입니다."

#: ../../templates.rst:168
msgid "``sidebar1``"
msgstr "``sidebar1``"

#: ../../templates.rst:169
