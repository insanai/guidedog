#: ../../reference/cli.rst:364
msgid "``register ID PATH [--project=DIR] [--config=FILE] [--yes]``: Inspects the program after user confirmation (``--yes`` bypasses confirmation) and records its SHA-256 hash. Build plugins pass qualification checks before registration."
msgstr ""

#: ../../reference/cli.rst:367
msgid "``check PATH [--project=DIR] [--config=FILE] [--timeout=SECONDS]``: Runs the full suite of qualification checks against a build plugin executable without writing to the machine registry."
msgstr ""

#: ../../reference/cli.rst:369
msgid "``list``: Lists all registered plugins, their IDs, paths, and interface kinds."
msgstr ""

#: ../../reference/cli.rst:370
msgid "``inspect ID``: Displays declared build hooks (source, HTML, assets) or publisher capabilities."
msgstr ""

#: ../../reference/cli.rst:371
msgid "``run ID -- [ARGS...]``: Runs a registered plugin program directly, verifying its SHA-256 pin first."
msgstr ""

#: ../../reference/cli.rst:372
msgid "``unregister ID``: Removes the specified plugin entry from ``plugins.toml``."
msgstr ""

#: ../../reference/cli.rst:374
msgid "In Guidedog 0.6.2, build plugins are selected by ``plugins`` in ``conf.toml``. Inspection displays their declared source, HTML, and asset hooks. Build plugins run during ``guidedog build``, while ``guidedog publish`` accepts publishers only. See :doc:`../plugins` for the complete guide, compiled example, and configuration."
msgstr ""

