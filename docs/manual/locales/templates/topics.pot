#: ../../topics/domains.rst:1
msgid "Domains"
msgstr ""

#: ../../topics/domains.rst:4
msgid "A domain is a set of directives and roles. They describe and cross-reference the objects of one programming language or one field of discourse."
msgstr ""

#: ../../topics/domains.rst:8
msgid "Guidedog has built-in implementations of the standard Sphinx domains:"
msgstr ""

#: ../../topics/domains.rst:10
msgid "**Standard domain** (``std``): General documentation objects such as command-line options, environment variables, terms, and UI labels."
msgstr ""

#: ../../topics/domains.rst:11
msgid "**Python domain** (``py``): Python modules, classes, functions, methods, attributes, properties, and exceptions."
msgstr ""

#: ../../topics/domains.rst:12
msgid "**C domain** (``c``): C functions, types, structs, unions, enums, enumerators, variables, and macros."
msgstr ""

#: ../../topics/domains.rst:13
msgid "**C++ domain** (``cpp``): C++ classes, concepts, templates, namespaces, methods, and expressions."
